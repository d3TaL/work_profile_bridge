+package dev.profilebridge.core.tls
+
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.IOException
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.SocketTimeoutException
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicReference
+import javax.net.ssl.SSLHandshakeException
+import javax.net.ssl.SSLServerSocket
+import javax.net.ssl.SSLSocket
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+
+enum class ProbeResult { REACHABLE, UNAVAILABLE, TLS_REJECTED, NOT_PERMITTED }
+
+class TlsProbe {
+    suspend fun listen(identity: TlsIdentity): TlsProbeSession {
+        var opened: TlsProbeSession? = null
+        try {
+            return withContext(Dispatchers.IO) {
+                val server = identity.context.serverSocketFactory.createServerSocket() as SSLServerSocket
+                try {
+                    server.enabledProtocols = arrayOf("TLSv1.3")
+                    server.needClientAuth = false
+                    server.soTimeout = 500
+                    server.bind(InetSocketAddress(LOOPBACK, 0), 1)
+                    TlsProbeSession(server, PairingCode.create(server.localPort, identity.certificatePin())).also { opened = it }
+                } catch (error: Exception) {
+                    server.close()
+                    throw error
+                }
+            }
+        } catch (cancelled: CancellationException) {
+            opened?.close()
+            throw cancelled
+        }
+    }
+
+    suspend fun ping(code: PairingCode): ProbeResult = withContext(Dispatchers.IO) {
+        try {
+            (TlsContexts.client(code.certificatePin()).socketFactory.createSocket() as SSLSocket).use { socket ->
+                socket.enabledProtocols = arrayOf("TLSv1.3")
+                socket.soTimeout = 2000
+                socket.connect(InetSocketAddress(LOOPBACK, code.port), 2000)
+                socket.startHandshake()
+                currentCoroutineContext().ensureActive()
+                val token = code.tokenCopy()
+                try {
+                    DataOutputStream(socket.outputStream).apply { writeInt(REQUEST); write(token); flush() }
+                } finally { token.fill(0) }
+                if (DataInputStream(socket.inputStream).readInt() == RESPONSE) ProbeResult.REACHABLE else ProbeResult.UNAVAILABLE
+            }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: SSLHandshakeException) {
+            ProbeResult.TLS_REJECTED
+        } catch (_: IllegalArgumentException) {
+            ProbeResult.TLS_REJECTED
+        } catch (_: IOException) {
+            ProbeResult.UNAVAILABLE
+        } catch (_: SecurityException) {
+            ProbeResult.NOT_PERMITTED
+        }
+    }
+
+    companion object {
+        internal const val REQUEST = 0x504C4232
+        internal const val RESPONSE = 0x504C424F
+        private val LOOPBACK = InetAddress.getByAddress(byteArrayOf(127, 0, 0, 1))
+    }
+}
+
+class TlsProbeSession internal constructor(
+    private val server: SSLServerSocket,
+    val code: PairingCode,
+) : AutoCloseable {
+    private val closed = AtomicBoolean()
+    private val activeClient = AtomicReference<SSLSocket?>()
+    private val createdNanos = System.nanoTime()
+
+    private fun valid(): Boolean = !closed.get() && System.nanoTime() - createdNanos < 120_000_000_000L
+
+    /** Deliberately only a fixed ping: never accept URL, package or commands here. */
+    suspend fun serve(): Unit = withContext(Dispatchers.IO) {
+        var attempts = 0
+        try {
+            while (valid() && attempts < 32) {
+                currentCoroutineContext().ensureActive()
+                try {
+                    (server.accept() as SSLSocket).use { socket ->
+                        attempts++
+                        activeClient.set(socket)
+                        try {
+                            if (!valid()) return@use
+                            socket.soTimeout = 2000
+                            socket.startHandshake()
+                            val input = DataInputStream(socket.inputStream)
+                            if (input.readInt() != TlsProbe.REQUEST) return@use
+                            val token = ByteArray(PairingCode.SECRET_BYTES)
+                            val allowed = try { input.readFully(token); code.accepts(token) } finally { token.fill(0) }
+                            currentCoroutineContext().ensureActive()
+                            if (allowed && valid()) {
+                                DataOutputStream(socket.outputStream).apply { writeInt(TlsProbe.RESPONSE); flush() }
+                            }
+                        } finally { activeClient.compareAndSet(socket, null) }
+                    }
+                } catch (_: SocketTimeoutException) {
+                    // Bounded accept/handshake/read; recheck cancellation and lifetime.
+                } catch (_: IOException) {
+                    if (server.isClosed) break
+                }
+            }
+        } finally { close() }
+    }
+
+    override fun close() {
+        if (closed.compareAndSet(false, true)) {
+            try { activeClient.getAndSet(null)?.close() } catch (_: IOException) { }
+            try { server.close() } catch (_: IOException) { }
+            finally { code.destroy() }
+        }
+    }
+}
