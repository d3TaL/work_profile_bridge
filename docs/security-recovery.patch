+package dev.profilebridge.app.ui
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import dev.profilebridge.app.platform.AndroidTlsIdentity
+import dev.profilebridge.core.tls.PairingCode
+import dev.profilebridge.core.tls.ProbeResult
+import dev.profilebridge.core.tls.TlsProbe
+import dev.profilebridge.core.tls.TlsProbeSession
+import java.io.IOException
+import java.security.GeneralSecurityException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+enum class ProbeStatus { IDLE, STARTING, LISTENING, FINISHED, CHECKING, REACHABLE, UNAVAILABLE, TLS_REJECTED, INVALID, SELF }
+data class ProbeState(
+    val sessionCode: String? = null,
+    val input: String = "",
+    val listener: ProbeStatus = ProbeStatus.IDLE,
+    val result: ProbeStatus = ProbeStatus.IDLE,
+) {
+    override fun toString(): String = "ProbeState([REDACTED])"
+}
+
+class ProbeViewModel : ViewModel() {
+    private val probe = TlsProbe()
+    private val mutable = MutableStateFlow(ProbeState())
+    val state = mutable.asStateFlow()
+    private var session: TlsProbeSession? = null
+    private var serverJob: Job? = null
+    private var clientJob: Job? = null
+
+    fun edit(value: String) {
+        if (clientJob?.isActive != true && value.length <= PairingCode.MAX_LENGTH) mutable.update { it.copy(input = value, result = ProbeStatus.IDLE) }
+    }
+    fun start() {
+        if (serverJob?.isCompleted == false) return
+        mutable.update { it.copy(listener = ProbeStatus.STARTING) }
+        serverJob = viewModelScope.launch {
+            var opened: TlsProbeSession? = null
+            try {
+                val listener = probe.listen(AndroidTlsIdentity.load())
+                opened = listener
+                session = listener
+                mutable.update { it.copy(sessionCode = listener.code.encodeForManualTransfer(), listener = ProbeStatus.LISTENING) }
+                listener.serve()
+                mutable.update { it.copy(listener = ProbeStatus.FINISHED) }
+            } catch (cancelled: CancellationException) { throw cancelled }
+            catch (_: IOException) { mutable.update { it.copy(listener = ProbeStatus.UNAVAILABLE) } }
+            catch (_: GeneralSecurityException) { mutable.update { it.copy(listener = ProbeStatus.TLS_REJECTED) } }
+            catch (_: java.security.ProviderException) { mutable.update { it.copy(listener = ProbeStatus.TLS_REJECTED) } }
+            catch (_: IllegalArgumentException) { mutable.update { it.copy(listener = ProbeStatus.TLS_REJECTED) } }
+            catch (_: SecurityException) { mutable.update { it.copy(listener = ProbeStatus.UNAVAILABLE) } }
+            finally {
+                opened?.close()
+                session = null
+                mutable.update { it.copy(sessionCode = null) }
+            }
+        }
+    }
+    fun stop() {
+        session?.close()
+        serverJob?.cancel()
+        mutable.update { it.copy(sessionCode = null, listener = ProbeStatus.FINISHED) }
+    }
+    fun ping() {
+        if (clientJob?.isActive == true) return
+        val input = state.value.input
+        val code = PairingCode.parse(input)
+        if (code == null || input == state.value.sessionCode) {
+            mutable.update { it.copy(result = if (code == null) ProbeStatus.INVALID else ProbeStatus.SELF) }
+            return
+        }
+        mutable.update { it.copy(input = "", result = ProbeStatus.CHECKING) }
+        clientJob = viewModelScope.launch {
+            val result = try { probe.ping(code) }
+            catch (_: GeneralSecurityException) { ProbeResult.TLS_REJECTED }
+            catch (_: java.security.ProviderException) { ProbeResult.TLS_REJECTED }
+            mutable.update { it.copy(result = when (result) {
+                ProbeResult.REACHABLE -> ProbeStatus.REACHABLE
+                ProbeResult.TLS_REJECTED -> ProbeStatus.TLS_REJECTED
+                else -> ProbeStatus.UNAVAILABLE
+            }) }
+        }
+    }
+    override fun onCleared() { session?.close() }
+}
