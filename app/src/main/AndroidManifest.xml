<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <permission android:name="${applicationId}.permission.STORE_TRANSFER" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.STORE_TRANSFER" />
    <!-- signature|appop: public CrossProfileApps consent flow, subject to DPC/OEM allowlisting.
         Checked dynamically before every send; not a claim of a system signature grant. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_PROFILES"
        tools:ignore="ProtectedPermissions" />
    <queries>
        <package android:name="ru.ozon.app.android" />
        <package android:name="com.wildberries.ru" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProfileBridge"
        android:usesCleartextTraffic="false">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/diagnostic_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop">
            <!-- User-selected HTTPS handler; we do not own shop domains or claim App Link verification. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="ozon.ru" />
                <data android:host="www.ozon.ru" />
                <data android:host="m.ozon.ru" />
                <data android:host="wildberries.ru" />
                <data android:host="www.wildberries.ru" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".StoreReceiveActivity" android:exported="true"
            android:permission="${applicationId}.permission.STORE_TRANSFER"
            android:launchMode="singleTop" />
    </application>
</manifest>
